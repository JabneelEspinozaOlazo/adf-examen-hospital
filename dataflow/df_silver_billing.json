{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(billing_id = toInteger(billing_id),",
				"          admission_id = toInteger(admission_id),",
				"          charge_type = iif(isNull(charge_type) || trim(charge_type)=='', 'Desconocido', trim(charge_type)),",
				"          payment_status = case(  lower(trim(payment_status)) == 'paid', 'Paid',  lower(trim(payment_status)) == 'unpaid', 'Unpaid',  lower(trim(payment_status)) == 'pending', 'Pending',  lower(trim(payment_status)) == 'overdue', 'Overdue',  'Desconocido' ),",
				"          amount = abs(toDecimal(trim(replace(replace(replace(upper(amount),'USD',''),'$',''),',','')), 12, 2)),",
				"          payment_date = case(  regexMatch(trim(payment_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(payment_date), 'yyyy-MM-dd'),  regexMatch(trim(payment_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(payment_date), 'MM/dd/yyyy'),  regexMatch(trim(payment_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(right(trim(payment_date),2)) <= 26, '20', '19'), right(trim(payment_date),2), '-', left(trim(payment_date),2), '-', substring(trim(payment_date),4,2)), 'yyyy-MM-dd'),  regexMatch(trim(payment_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(payment_date), 'dd-MMM-yyyy'),  regexMatch(trim(payment_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(payment_date), 'MMMM dd, yyyy') )) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(billing_id) && !isNull(admission_id) && !isNull(amount)) ~> filter1",
				"filter1, source2 exists(derivedColumn1@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> sink1"
			]
		}
	}
}
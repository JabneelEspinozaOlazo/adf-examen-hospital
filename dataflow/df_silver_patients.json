{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = toInteger(patient_id),",
				"          full_name = trim(full_name),",
				"          gender = case(in(['M','MALE'], upper(trim(gender))), 'Masculino', in(['F','FEMALE'], upper(trim(gender))), 'Femenino', toString(null())),",
				"          phone = iif(\r",
				"    isNull(phone) || trim(phone) == '',\r",
				"    'SIN TELEFONO',\r",
				"    phone\r",
				"),",
				"          email = iif(\r",
				"    isNull(email) || trim(email) == '',\r",
				"    'SIN CORREO',\r",
				"    email\r",
				"),",
				"          address = iif(isNull(address) || trim(address)=='', toString(null()), trim(address)),",
				"          date_of_birth = case(\r",
				" regexMatch(trim(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				" regexMatch(trim(date_of_birth), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				" regexMatch(trim(date_of_birth), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(right(trim(date_of_birth),2)) <= 26, '20', '19'), right(trim(date_of_birth),2), '-', left(trim(date_of_birth),2), '-', substring(trim(date_of_birth),4,2)), 'yyyy-MM-dd'),\r",
				" regexMatch(trim(date_of_birth), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				" regexMatch(trim(date_of_birth), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(date_of_birth), 'MMMM dd, yyyy')\r",
				"),",
				"          insurance_provider = case(\r",
				" regexMatch(lower(trim(insurance_provider)), '^aetna.*'), 'Aetna',\r",
				" regexMatch(lower(trim(insurance_provider)), '^blue.?cross.*'), 'BlueCross',\r",
				" regexMatch(lower(trim(insurance_provider)), '^cigna.*'), 'Cigna',\r",
				" regexMatch(lower(trim(insurance_provider)), '^medicaid$'), 'Medicaid',\r",
				" regexMatch(lower(trim(insurance_provider)), '^medi.?care$'), 'Medicare',\r",
				" regexMatch(lower(trim(insurance_provider)), '^self.?pay$'), 'Self Pay',\r",
				" regexMatch(lower(trim(insurance_provider)), '^(uhc|united.?health)$'), 'UnitedHealth',\r",
				" 'Desconocido'\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}
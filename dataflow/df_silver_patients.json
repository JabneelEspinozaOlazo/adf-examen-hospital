{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = toInteger(patient_id),",
				"          full_name = trim(full_name),",
				"          gender = case(in(['M','MALE'], upper(trim(gender))), 'Masculino', in(['F','FEMALE'], upper(trim(gender))), 'Femenino', toString(null())),",
				"          phone = iif(\r",
				"    isNull(phone) || trim(phone) == '',\r",
				"    'SIN TELEFONO',\r",
				"    phone\r",
				"),",
				"          email = iif(\r",
				"    isNull(email) || trim(email) == '',\r",
				"    'SIN CORREO',\r",
				"    email\r",
				"),",
				"          address = iif(isNull(address) || trim(address)=='', toString(null()), trim(address)),",
				"          date_of_birth = case(\r",
				"    isNull(date_of_birth) || trim(date_of_birth) == '',\r",
				"    toDate('1900-01-01', 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(trim(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(trim(date_of_birth), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"    toDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"\r",
				"    regexMatch(trim(date_of_birth), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"    toDate(\r",
				"        concat(\r",
				"            iif(toInteger(right(trim(date_of_birth),2)) <= 26, '20', '19'),\r",
				"            right(trim(date_of_birth),2),\r",
				"            '-',\r",
				"            substring(trim(date_of_birth),4,2),\r",
				"            '-',\r",
				"            left(trim(date_of_birth),2)\r",
				"        ),\r",
				"        'yyyy-MM-dd'\r",
				"    ),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} enero [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-01-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} febrero [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-02-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} marzo [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-03-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} abril [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-04-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} mayo [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-05-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} junio [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-06-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} julio [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-07-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} agosto [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-08-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} septiembre [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-09-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} octubre [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-10-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} noviembre [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-11-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(lower(trim(date_of_birth)), '^[0-9]{1,2} diciembre [0-9]{4}$'),\r",
				"    toDate(concat(right(trim(date_of_birth),4),'-12-',left(trim(date_of_birth),2)), 'yyyy-MM-dd'),\r",
				"\r",
				"    regexMatch(trim(date_of_birth), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),\r",
				"    toDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"\r",
				"    toDate('1900-01-01', 'yyyy-MM-dd')\r",
				"),",
				"          insurance_provider = lower(replace(replace(trim(insurance_provider),' ',''),'-',''))) ~> derivedColumn1"
			]
		}
	}
}
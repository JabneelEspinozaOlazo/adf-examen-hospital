{
	"name": "df_silver_diagnoses",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(diagnosis_id = toInteger(diagnosis_id),",
				"          admission_id = toInteger(admission_id),",
				"          diagnosis_description = iif(isNull(diagnosis_description) || trim(diagnosis_description)=='', toString(null()), trim(diagnosis_description)),",
				"          severity = case(  lower(trim(severity)) == 'mild', 'Mild',  lower(trim(severity)) == 'moderate', 'Moderate',  lower(trim(severity)) == 'severe', 'Severe',  lower(trim(severity)) == 'critical', 'Critical',  toString(null()) ),",
				"          icd_code = concat(  left(replace(replace(replace(upper(trim(split(icd_code, ',')[1])),'-',''),'.',''),' ',''), 3),  iif(length(replace(replace(replace(upper(trim(split(icd_code, ',')[1])),'-',''),'.',''),' ','')) > 3,      concat('.', substring(replace(replace(replace(upper(trim(split(icd_code, ',')[1])),'-',''),'.',''),' ',''), 4, 20)),      '') )) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(diagnosis_id) && !isNull(admission_id) && icd_code != '') ~> filter1",
				"filter1, source2 exists(derivedColumn1@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}
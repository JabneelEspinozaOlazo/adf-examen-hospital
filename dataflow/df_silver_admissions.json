{
	"name": "df_silver_admissions",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_patients",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(admission_id = toInteger(admission_id),",
				"          patient_id = toInteger(patient_id),",
				"          attending_doctor_id = toInteger(attending_doctor_id),",
				"          department = case(  regexMatch(lower(trim(department)), '^gen.*'), 'General Surgery',  regexMatch(lower(trim(department)), '^(neu|nue).*'), 'Neurology',  regexMatch(lower(trim(department)), '^card.*'), 'Cardiology',  regexMatch(lower(trim(department)), '^ortho.*'), 'Orthopedics',  regexMatch(lower(trim(department)), '^(emer.*|er)$'), 'Emergency',  regexMatch(lower(trim(department)), '^(ped|paed).*'), 'Pediatrics',  regexMatch(lower(trim(department)), '^onco.*'), 'Oncology',  'Desconocido' ),",
				"          admission_date = case(\r",
				" regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(admission_date), 'yyyy-MM-dd'),\r",
				" regexMatch(trim(admission_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(admission_date), 'MM/dd/yyyy'),\r",
				" regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(right(trim(admission_date),2)) <= 26, '20', '19'), right(trim(admission_date),2), '-', left(trim(admission_date),2), '-', substring(trim(admission_date),4,2)), 'yyyy-MM-dd'),\r",
				" regexMatch(trim(admission_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
				" regexMatch(trim(admission_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(admission_date), 'MMMM dd, yyyy')\r",
				"),",
				"          discharge_date = case(  regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(discharge_date), 'yyyy-MM-dd'),  regexMatch(trim(discharge_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(discharge_date), 'MM/dd/yyyy'),  regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(right(trim(discharge_date),2)) <= 26, '20', '19'), right(trim(discharge_date),2), '-', left(trim(discharge_date),2), '-', substring(trim(discharge_date),4,2)), 'yyyy-MM-dd'),  regexMatch(trim(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(discharge_date), 'dd-MMM-yyyy'),  regexMatch(trim(discharge_date), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(discharge_date), 'MMMM dd, yyyy') )) ~> derivedColumn1",
				"derivedColumn1 derive(discharge_date = iif(discharge_date >= admission_date, discharge_date, toDate(null()))) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(admission_date) && !isNull(admission_id) && !isNull(patient_id)) ~> filter1",
				"filter1, source2 exists(derivedColumn1@patient_id == source2@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}